# Copy to .env and fill in. Never commit .env — the repository is public.
# On Vercel, set the same names under Settings → Environment Variables.

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Leave empty locally to use the embedded database in .data/.
# On Vercel: add a Neon database (Storage tab) and use its pooled URL.
DATABASE_URL=
# Public URL of the site. Printed in each passport's QR code and used for Google sign-in.
APP_URL=http://localhost:8080

# ── Accounts ──────────────────────────────────────────────────────────────
# First administrator, created by `npm run db:seed` (password: 12+ characters).
ADMIN_EMAIL=admin@btu.edu.ge
ADMIN_PASSWORD=
# Demo only: gives every test student an account with this password. Leave empty in production.
SEED_STUDENT_PASSWORD=
# Only emails on this domain (or its subdomains) can sign in or register.
ALLOWED_EMAIL_DOMAIN=btu.edu.ge
# Demo only: the hackathon workbook uses @example.org test emails; this maps them to the domain above.
EMAIL_DOMAIN_REWRITE=

# ── BTU issuer identity & blockchain ──────────────────────────────────────
# secp256k1 private key (0x…). Signs every passport version and sends the anchoring transactions.
# Its address is published at /.well-known/did.json. Generate one with:
#   node -e "import('viem/accounts').then(m=>console.log(m.generatePrivateKey()))"
ISSUER_PRIVATE_KEY=
# Optional: the issuer DID. Defaults to did:web:<APP_URL host>; in production use did:web:btu.edu.ge.
ISSUER_DID=
# "evm" (default when ISSUER_PRIVATE_KEY is set) or "none" (no blockchain, development only).
ANCHOR_PROVIDER=evm
# sepolia | polygonAmoy | baseSepolia | mainnet | polygon | base
ANCHOR_CHAIN=sepolia
# Optional RPC endpoint; the chain's public RPC is used when empty.
ANCHOR_RPC_URL=

# ── Google sign-in (OAuth client, type "Web application") ─────────────────
# Redirect URI: <APP_URL>/api/auth/google/callback. Leave empty and the button explains it's not connected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Sheets skill registry (service account) ────────────────────────
# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Passport Skill Records
# From the service account's JSON key: "client_email" and "private_key" (keep the \n sequences).
# Share the sheet with this email as Editor so sync results can be written back (columns G, Q–T).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Automatic sync triggers ───────────────────────────────────────────────
# Shared secret for the Apps Script webhook (POST /api/sync/webhook). Any long random string.
SYNC_WEBHOOK_SECRET=
# Vercel Cron sends this automatically to GET /api/cron/sync. Any long random string.
CRON_SECRET=

# Email (sign-up codes and "passport updated" notices) through Resend. Without these, mail is
# printed to the server console; in production email sign-up is then disabled (Google only).
RESEND_API_KEY=
MAIL_FROM=

# Optional live registry from an Excel file on disk (local/demo). Loaded on first start and
# re-synced when the file is saved. Google Sheets takes priority when configured.
REGISTRY_EXCEL_PATH=

# Hosted testing without a mail service: email sign-up skips the code step. Accounts wait for
# admin approval and cannot claim registry students. Remove once RESEND_API_KEY is set.
ALLOW_UNVERIFIED_SIGNUP=
